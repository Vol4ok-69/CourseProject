# СУБД PostgreSQL (Docker Compose)
POSTGRES_DB=YOUR_SECURE_POSTGRES_DB_NAME_HERE
POSTGRES_USER=YOUR_SECURE_POSTGRES_USER_HERE
POSTGRES_PASSWORD=YOUR_SECURE_POSTGRES_PASSWORD_HERE
POSTGRES_PORT=5433

# Безопасность и криптографические ключи
## JWT_KEY: Секретный ключ подписи HMAC-SHA256. Минимальная длина: 256 бит (32 символа).
## JWT_ISSUER / JWT_AUDIENCE: Издатель и аудитория токенов JWT
JWT_KEY=YOUR_SECURE_JWT_SECRET_KEY_MIN_32_CHARACTERS_LONG_HERE
JWT_ISSUER=YOUR_JWT_ISSUER_HERE
JWT_AUDIENCE=YOUR_JWT_AUDIENCE_HERE

# TOKEN_ENCRYPTION_KEY: Ключ симметричного шифрования токенов GitHub (AES-256-GCM).
## Требование исходного кода (Program.cs): валидный Base64 ровно от 32 байт (256 бит).
TOKEN_ENCRYPTION_KEY=YOUR_SECURE_TOKEN_ENCRYPTION_KEY_HERE

# Включение OpenAPI / Swagger в Production окружении
SWAGGER_ENABLED=false

# CORS: Разрешённые источники веб-клиентов через запятую (RFC 6454: схема://хост[:порт]).
## По умолчанию при отсутствии переменной: http://localhost:5173,http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Docker Socket и права доступа (DooD)
## GID группы docker на хосте для доступа непривилегированного пользователя Backend к сокету /var/run/docker.sock.
## - Windows / macOS (Docker Desktop): оставить 0 (доступ управляется виртуализацией Docker Desktop).
## - Linux: указать фактический GID группы docker на хосте (команда: getent group docker | cut -d: -f3 или stat -c '%g' /var/run/docker.sock).
## Неправильный GID на Linux приведёт к ошибке доступа Backend к сокету Docker daemon при запуске анализа БД.
DOCKER_GID=0

# Параметры интеграционных тестов и внешних скриптов проверки (tests/test_all.ps1)
## Базовый URL API (для локального Docker-контейнера: http://localhost:5000)
API_BASE_URL=http://localhost:5000

# Учётные данные администратора для автоматизированных проверок
API_ADMIN_USERNAME=YOUR_ADMIN_USERNAME_HERE
API_ADMIN_PASSWORD=YOUR_ADMIN_PASSWORD_HERE

# Таймауты и интервал опроса фонового анализа коммитов
ANALYSIS_TIMEOUT_SEC=120
ANALYSIS_POLL_INTERVAL_SEC=2
